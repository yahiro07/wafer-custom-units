# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# next.js
.next/
out/

# production builds
build/
dist/

# testing / coverage
coverage/

# env files (never commit secrets)
.env
.env*.local

# vercel
.vercel

# typescript build artifacts
*.tsbuildinfo
next-env.d.ts

# logs
*-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# os / editor
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
